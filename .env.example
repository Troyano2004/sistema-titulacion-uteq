# ============================================================================
# Variables de entorno requeridas por el Backend (Spring Boot).
#
# Copiar este archivo a `.env` (o exportarlas de otra forma en el entorno de
# ejecucion) y completar con valores reales. NUNCA commitear el `.env` real:
# ya deberia estar cubierto por Backend/.gitignore.
#
# Las variables marcadas [OBLIGATORIA] hacen que el backend falle al arrancar
# si faltan (a proposito: evita que corra con un secreto por defecto inseguro).
# Las marcadas [opcional] tienen un valor por defecto razonable en
# application.properties.
# ============================================================================

# ── Base de datos PostgreSQL ────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/efrain          # [opcional]
DB_USERNAME=postgres                                     # [opcional]
DB_PASSWORD=                                             # [OBLIGATORIA]

# ── Seguridad (JWT / cifrado) ───────────────────────────────────────────────
# JWT_SECRET: clave Base64 de al menos 32 bytes usada para firmar los tokens
# de sesion. Generar una nueva, propia de este ambiente, por ejemplo con:
#   openssl rand -base64 32
# NO reutilizar la clave que estaba hardcodeada en el codigo — esa quedo
# expuesta en el historial de git y debe considerarse comprometida.
JWT_SECRET=                                              # [OBLIGATORIA]

# AES_KEY / AES_IV: usadas para cifrar/descifrar contrasenas de base de datos
# guardadas por usuario (usuario.password_db_encrypted) y la contrasena SMTP
# guardada en configuracion_correo. Generar valores propios y nuevos, por
# ejemplo con: openssl rand -hex 8   (da 16 caracteres hex = 16 bytes)
# NO reutilizar la clave que estaba hardcodeada en el codigo.
AES_KEY=                                                 # [OBLIGATORIA] 16 bytes (AES-128)
AES_IV=                                                  # [OBLIGATORIA] 16 bytes

# ── Azure Blob Storage (documentos/imagenes) ────────────────────────────────
AZURE_BLOB_CONNECTION_STRING=                            # [OBLIGATORIA]
AZURE_BLOB_CONTAINER=imagenes-documentos                 # [opcional]

# ── Correo (Gmail SMTP) ──────────────────────────────────────────────────────
GMAIL_USERNAME=                                          # [OBLIGATORIA]
GMAIL_PASSWORD=                                          # [OBLIGATORIA] app password de Gmail, no la contrasena de la cuenta

# ── Google OAuth (respaldos en Google Drive) ────────────────────────────────
# NO reutilizar el client id/secret que estaban hardcodeados en el codigo
# (GoogleDriveOAuthService.java) — esa credencial quedo expuesta en el
# historial de git y debe rotarse en Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=                                  # [OBLIGATORIA]
GOOGLE_OAUTH_CLIENT_SECRET=                              # [OBLIGATORIA]

# ── Zoom (generacion de enlaces de reunion) ─────────────────────────────────
ZOOM_ACCOUNT_ID=                                         # [OBLIGATORIA]
ZOOM_CLIENT_ID=                                          # [OBLIGATORIA]
ZOOM_CLIENT_SECRET=                                      # [OBLIGATORIA]

# ── Groq API (asistencia IA en revision de propuestas/documentos) ──────────
GROQ_API_KEY=                                            # [OBLIGATORIA]

# ── WasItAIGenerated (deteccion de texto generado por IA en antiplagio) ────
# Antes vivia hardcodeada en el frontend (antiplagio-dt2.ts); ahora el
# frontend llama a POST /api/antiplagio/verificar-texto en el backend, que
# reenvia la peticion a este servicio con la key guardada solo en servidor.
WASITAI_API_KEY=                                         # [opcional] sin ella, el endpoint responde 503

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_ENCRYPTION_KEY=                                   # [OBLIGATORIA]

# ── Recovery Mode (arranque de emergencia sin BD) ───────────────────────────
RECOVERY_PASSWORD=                                       # [OBLIGATORIA]
RECOVERY_EMERGENCY_REFRESH_TOKEN=                        # [opcional]
RECOVERY_EMERGENCY_FOLDER_ID=                            # [opcional]
RECOVERY_EMERGENCY_PG_HOST=localhost                     # [opcional]
RECOVERY_EMERGENCY_PG_PORT=5432                          # [opcional]
RECOVERY_EMERGENCY_PG_USER=postgres                      # [opcional]
RECOVERY_EMERGENCY_PG_PASSWORD_ENC=                      # [opcional] cifrado con AES_KEY/AES_IV
RECOVERY_EMERGENCY_PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe   # [opcional]
RECOVERY_EMERGENCY_DATABASES=efrain                      # [opcional]
RECOVERY_LOCAL_BACKUP_PATH=C:\Respaldos                  # [opcional]
