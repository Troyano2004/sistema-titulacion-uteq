# ============================================================================
# PLANTILLA de configuracion — copiar a application.properties y completar
# con valores reales. application.properties NUNCA debe commitearse con
# valores reales (deberia estar en .gitignore).
#
# Todos los valores sensibles se leen de variables de entorno (ver .env.example
# en la raiz del proyecto). Los que tienen ":" despues del nombre tienen un
# valor por defecto y son opcionales; el resto son obligatorios para arrancar.
# ============================================================================

# Configuracion de la conexion a PostgreSQL
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/efrain}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD}
spring.jpa.properties.hibernate.temp.use_jdbc_metadata_defaults=false
spring.datasource.driver-class-name=org.postgresql.Driver

# Configuracion de Hibernate (JPA)
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# ================================
# Migraciones de base de datos
# ================================
spring.flyway.enabled=false
spring.flyway.baseline-on-migrate=true

# Configuracion de Azure Blob Storage
azure.storage.connection-string=${AZURE_BLOB_CONNECTION_STRING}
azure.storage.container-name=${AZURE_BLOB_CONTAINER:imagenes-documentos}

# ================================
# Hikari (POOL DEFAULT)
# ================================
spring.datasource.hikari.pool-name=POOL_DEFAULT
spring.datasource.hikari.maximum-pool-size=15
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.connection-timeout=5000
spring.datasource.hikari.max-lifetime=1800000
spring.datasource.hikari.data-source-properties.ApplicationName=BACKEND_TITU_DEFAULT

# ================================
# SESSION
# ================================
server.servlet.session.cookie.http-only=true
server.servlet.session.tracking-modes=cookie
server.servlet.session.cookie.same-site=lax
server.servlet.session.timeout=1m

# ================================
# GEMINI API
# ================================
gemini.api.url=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# ================================
# MULTIPART (subida de archivos)
# ================================
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=20MB
spring.servlet.multipart.max-request-size=22MB

# ================================
# MAIL
# ================================
spring.mail.host=smtp.gmail.com
spring.mail.port=465
spring.mail.username=${GMAIL_USERNAME}
spring.mail.password=${GMAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.ssl.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000
app.mail.from=${GMAIL_USERNAME}
app.mail.from-name=Sistema de Titulacion UTEQ

# ================================
# SCHEDULERS — Módulo 6 (Propuesta del TIC)
# ================================
app.scheduler.cambio-automatico-complexivo.enabled=true
app.scheduler.cambio-automatico-complexivo.cron=0 0 3 * * *
app.scheduler.plazos-titulacion.enabled=true
app.scheduler.plazos-titulacion.cron=0 0 6 * * *

# ================================
# ZOOM
# ================================
zoom.account-id=${ZOOM_ACCOUNT_ID}
zoom.client-id=${ZOOM_CLIENT_ID}
zoom.client-secret=${ZOOM_CLIENT_SECRET}

# ================================
# GROQ API
# ================================
groq.api.url=https://api.groq.com/openai/v1/chat/completions
groq.api.key=${GROQ_API_KEY}

# ================================
# WASITAI GENERATED (deteccion de texto generado por IA)
# ================================
wasitai.api.url=https://www.wasitaigenerated.com/api/v1/detect/text
wasitai.api.key=${WASITAI_API_KEY:}

# ================================
# Auditoria - async pool
# ================================
spring.task.execution.pool.core-size=2
spring.task.execution.pool.max-size=5
spring.task.execution.pool.queue-capacity=100
spring.task.execution.thread-name-prefix=audit-async-

# ================================
# BACKUP
# ================================
backup.encryption.key=${BACKUP_ENCRYPTION_KEY}

# ================================
# RECOVERY MODE
# ================================
recovery.password=${RECOVERY_PASSWORD}
recovery.emergency.refresh-token=${RECOVERY_EMERGENCY_REFRESH_TOKEN:}
recovery.emergency.folder-id=${RECOVERY_EMERGENCY_FOLDER_ID:}
recovery.emergency.pg-host=${RECOVERY_EMERGENCY_PG_HOST:localhost}
recovery.emergency.pg-port=${RECOVERY_EMERGENCY_PG_PORT:5432}
recovery.emergency.pg-usuario=${RECOVERY_EMERGENCY_PG_USER:postgres}
recovery.emergency.pg-password-enc=${RECOVERY_EMERGENCY_PG_PASSWORD_ENC:}
recovery.emergency.pg-dump-path=${RECOVERY_EMERGENCY_PG_DUMP_PATH:C:\\Program Files\\PostgreSQL\\18\\bin\\pg_dump.exe}
recovery.emergency.databases=${RECOVERY_EMERGENCY_DATABASES:efrain}
recovery.local.backup-path=${RECOVERY_LOCAL_BACKUP_PATH:C:\\Respaldos}
